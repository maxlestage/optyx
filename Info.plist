<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Optyx est une app photo : pas de Game Mode. Déclarer la clé
	     explicitement fait taire l'avertissement du HUD Metal
	     « LSSupportsGameMode key not found in Info.plist » affiché en
	     surimpression du viseur. Les autres clés (permissions, scènes…)
	     restent générées par Xcode (GENERATE_INFOPLIST_FILE) et sont
	     fusionnées dans ce fichier au build. -->
	<key>LSSupportsGameMode</key>
	<false/>
	<!-- Crédits de l'app, lisibles dans les informations du bundle. -->
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Maxime Nathan Lestage</string>
	<!-- NSPhotoLibraryAddUsageDescription n'est PAS déclarée ici : elle
	     l'est déjà par le réglage de projet
	     INFOPLIST_KEY_NSPhotoLibraryAddUsageDescription, que
	     GENERATE_INFOPLIST_FILE fusionne dans ce fichier au build. La
	     déclarer aux deux endroits donnerait deux textes concurrents pour
	     une même clé, sans que rien signale lequel l'emporte.

	     C'est la SEULE permission de l'app : l'import passe par
	     PhotosPicker (PHPickerViewController), qui s'exécute hors du
	     processus et ne réclame aucun accès à la photothèque. -->
	<!-- Ni caméra ni micro : cette version n'a ni viseur ni vidéo. -->

</dict>
</plist>
